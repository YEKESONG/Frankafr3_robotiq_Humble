<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>robotiq_franka_shim</name>
  <version>0.1.0</version>
  <description>
    franka_gripper-compatible shim for a Robotiq 2F-85 on a Franka FR3.
    Targets ROS 2 Humble / Ubuntu 22.04.
  </description>
  <maintainer email="songykee@gmail.com">SONG Yeke</maintainer>
  <license>BSD-3-Clause</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>control_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>

  <exec_depend>controller_manager</exec_depend>
  <!-- Humble: position_controllers/GripperActionController lives here.
       On Jazzy and newer this becomes parallel_gripper_controller. -->
  <exec_depend>gripper_controllers</exec_depend>

  <!-- Pulled from source via fr3_robotiq.humble.repos, not from apt. -->
  <exec_depend>robotiq_driver</exec_depend>
  <exec_depend>robotiq_controllers</exec_depend>

  <exec_depend>xacro</exec_depend>

  <!-- franka_msgs is intentionally not listed: it comes from the franka_ros2
       workspace, and without it the shim still serves
       /franka_gripper/gripper_action (it degrades instead of failing). -->

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
